#!/usr/bin/env bash
set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
PACKAGE_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

PYTHON="$PACKAGE_DIR/.venv/bin/python3"
if [ ! -f "$PYTHON" ]; then
  PYTHON="$PACKAGE_DIR/.venv/bin/python"
fi

if [ ! -f "$PYTHON" ]; then
  echo ""
  echo "  TRUTHZERO: Python venv not found."
  echo "  Run: npm rebuild truthzero"
  echo "  Or:  cd $PACKAGE_DIR && python3 -m venv .venv && .venv/bin/pip install -e ."
  echo ""
  exit 1
fi

exec "$PYTHON" -m truthzero "$@"
